# MediaKit 环境变量示例。复制为 .env 后按需修改。
# docker compose 会自动读取同目录 .env。

# ---- docker-compose 宿主端口（避免与本地冲突可在 .env 改） ----
MYSQL_PORT=3316
REDIS_PORT=6389

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=mediakit_root
MYSQL_DATABASE=mediakit
MYSQL_USER=mediakit
MYSQL_PASSWORD=mediakit_pw

# ---- apps/server 应用变量（见 apps/server/.env.example） ----
# 见 apps/server/.env.example，server 启动时读取。
