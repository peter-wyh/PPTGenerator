{
  "name": "mediakit",
  "version": "0.1.0",
  "private": true,
  "description": "MediaKit — 广告投放报告编辑器（demo.html 全新重写，全栈）",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mediakit/server prisma migrate deploy",
    "db:seed": "pnpm --filter @mediakit/server db:seed"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.9",
      "qs": "^6.16.0",
      "body-parser": "^1.20.6",
      "react-router": "6.30.6",
      "react-router-dom": "6.30.6"
    }
  }
}
