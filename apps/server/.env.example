# apps/server 应用变量。复制为 .env。

NODE_ENV=development
PORT=4000

# 指向 docker-compose 的 mysql（端口见根 .env 的 MYSQL_PORT）
DATABASE_URL="mysql://mediakit:mediakit_pw@localhost:3317/mediakit"

# Redis
REDIS_URL="redis://localhost:6389"
# Redis DB index (0-15)，多个服务共用同一 Redis 实例时指定不同 DB 隔离（见 config.ts redisDb）
REDIS_DB=0

# JWT —— 生产请替换为强随机值
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# refresh cookie 是否仅 https（本地 http 调试设 false）
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# CORS 允许来源（逗号分隔）
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# ---- 文件上传存储 ----
# 存储驱动：local=本地目录（默认） / oss=阿里云 OSS
STORAGE_DRIVER=local
# 本地驱动：文件落盘目录 + 对外可访问基址（静态托管在 /uploads）
UPLOAD_DIR=./uploads
PUBLIC_BASE=http://localhost:4000
# OSS 驱动（仅 STORAGE_DRIVER=oss 且配齐以下四项时启用，否则降级本地）
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=your-key-id
# OSS_ACCESS_KEY_SECRET=your-key-secret
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
