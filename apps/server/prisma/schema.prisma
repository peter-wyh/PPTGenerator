// MediaKit Prisma schema (MySQL 8)
// 对齐 design spec §3.3 — pages 为不透明 JSON，组件类型扩展不触发迁移。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         Role       @default(USER)
  /// 归属业务线 code（如 'DG'）。ADMIN 为 NULL = 不限。存 code 不存 FK，
  /// 与 Campaign.businessLineCode / ReportScheme.businessLineCode 约定一致。
  businessLineCode String?
  projects     Project[]
  templates    Template[]
  dataRecords  DataRecord[]
  campaigns    Campaign[]
  creators     Creator[]
  schemes      ReportScheme[]
  htmlTemplates HtmlTemplate[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([businessLineCode])
}

model Project {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  pages      Json
  width      Int      @default(1280)
  height     Int      @default(720)
  shareToken String?  @unique
  // 项目元数据（业务线/创建人/场景/广告主/campaign 信息），不透明 JSON。
  meta       Json?
  /// 报告方案版本（追溯生成报告时所用的方案版本）。
  reportSchemeVersion String?
  /// AI/模板生成的 HTML 报告内容（单文件，内联 CSS）。styleType='ai-html' 时使用。
  /// 保留向后兼容；新数据写入 HtmlVersion 表。
  htmlContent String? @db.LongText
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  htmlVersions HtmlVersion[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

/// AI 生成的 HTML 报告版本（一个 Project 可有多个版本）。
model HtmlVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 版本名称（用户可编辑，如"投放结案 v1"、"达人复盘"）
  name        String
  /// HTML 内容（内联 CSS/JS 的完整单文件）
  html        String   @db.LongText
  /// 来源信息：哪个 preset 生成的、用的什么 prompt
  source      String?
  /// recipe 报告:用哪套 recipe(ai 报告为 null)
  recipeId          String?
  /// recipe 报告:渲染用数据快照(CampaignReportContent)
  reportContent     Json?
  /// recipe 报告:配色/字体覆盖(只存改过的 key)
  tokenOverrides    Json?
  /// recipe 报告:组件顺序 + 显隐 { order: string[], hidden: string[] }
  manifestOverrides Json?
  /// 是否为当前激活版本（前端默认展示）
  isActive    Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([ownerId])
}

/// 报告模版：由设计师(ADMIN)维护、按场景+业务线分类，供 BD 基于模版创建报告。
/// pages/width/height/meta 结构与 Project 完全一致，编辑器可直接复用。
model Template {
  id         String           @id @default(cuid())
  name       String
  pages      Json
  width      Int              @default(1280)
  height     Int              @default(720)
  meta       Json?
  status     TemplateStatus   @default(DRAFT)
  /// 设计师备注（可选），仅管理后台可见。
  note       String?
  /// HTML 报告模板内容（renderType='html-report' 时使用）。
  htmlContent String?         @db.LongText
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

/// 数据管理库记录:Campaign / 达人库(Creator)统一存储,opaque JSON payload。全员可管,ownerId 标记创建者。
model DataRecord {
  /// id 由应用层生成(opaque),不使用 cuid() 默认值——便于导入按 id upsert 幂等。
  id        String          @id
  kind      DataRecordKind
  ownerId   String
  data      Json
  /// COLLABORATION 记录的 campaignId(便于按 campaign 查);其余 kind 为 null。
  /// 由 data.service 写入时同步(SP1),非 DB 生成列。
  scopeCampaignId String?
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([kind])
  @@index([ownerId])
  @@index([kind, scopeCampaignId], map: "idx_data_kind_scope")
}

/// 数据记录类型。
enum DataRecordKind {
  CAMPAIGN
  CREATOR
  COLLABORATION
}

// ─── Phase 1: 结构化查找表 ─────────────────────────────────────────────────
// 将 mock 常量提升为独立表,支持 CRUD 管理 + 结构化查询。

/// 商家（母品牌/旗舰店）。
model Merchant {
  id        String         @id @default(cuid())
  name      String         @unique
  logo      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  businessLines BusinessLine[]
  advertisers  Advertiser[]
}

/// 业务线（对齐营销系统 dm_union_business_lines）。
/// 源侧字段区命名/类型/默认值与 DDL 一致；本地扩展字段（code/logo/color/designMd 等）单独分区，同步时不覆盖。
model BusinessLine {
  /// 本地 cuid 主键（源为 bigint unsigned 自增；本地 FK 链均为 String，保留 cuid，同步映射时转换）。
  id         String   @id @default(cuid())
  /// 名称（源 title varchar(50) NOT NULL DEFAULT ''）。
  title      String   @default("") @db.VarChar(50)
  /// 负责人 ids（源 director_id varchar(500) NOT NULL DEFAULT ''，逗号分隔）。
  directorId String   @default("") @db.VarChar(500) @map("director_id")
  /// 负责成员 ids（源 members text NULL）。
  members    String?  @db.Text
  /// 额外信息（源 extra text NULL）。
  extra      String?  @db.Text
  /// 创建人 ID（源 creator_id bigint unsigned NOT NULL DEFAULT 0，关联 dm_admin；本地存原始 id 字符串，不建 FK——源/本地用户体系不同）。
  creatorId  String?  @map("creator_id")
  /// 更新人 ID（源 updator_id，关联 dm_admin；同上不建 FK）。
  updatorId  String?  @map("updator_id")
  /// 创建时间（源 create_time datetime NULL）。
  createTime DateTime? @map("create_time")
  /// 更新时间（源 update_time datetime NULL）。
  updateTime DateTime? @map("update_time")
  /// 删除时间（源 delete_time datetime NULL；软删标记，NULL=未删）。
  deleteTime DateTime? @map("delete_time")
  /// 业务线状态（源 status tinyint(1) NOT NULL DEFAULT 1）。
  status     Int      @default(1) @db.TinyInt
  /// 作品提及（源 expert_work_mention json NULL，字符串数组）。
  expertWorkMention Json? @map("expert_work_mention")
  /// 作品标签（源 expert_work_label json NULL，字符串数组）。
  expertWorkLabel   Json? @map("expert_work_label")
  /// 所属公司（源 company_ids varchar(500) NOT NULL DEFAULT '0'）。
  companyIds String   @default("0") @db.VarChar(500) @map("company_ids")
  /// 部门 ids（源 department_ids varchar(2000) NOT NULL DEFAULT ''）。
  departmentIds String @default("") @db.VarChar(2000) @map("department_ids")
  /// 指定成员（源 specify_members text NULL）。
  specifyMembers String? @db.Text @map("specify_members")
  /// cpt 余额提现 0否1是（源 cpt_withdraw tinyint(1) NOT NULL DEFAULT 0）。
  cptWithdraw Boolean @default(false) @map("cpt_withdraw")
  /// 关联应用（源 related_project varchar(255) NOT NULL DEFAULT ''）。
  relatedProject String @default("") @db.VarChar(255) @map("related_project")
  /// 日历管理员 ids（源 calendar_admin_ids varchar(1000) NOT NULL DEFAULT ''）。
  calendarAdminIds String @default("") @db.VarChar(1000) @map("calendar_admin_ids")

  // ─── 本地扩展（报告侧配置；源表无，同步时不覆盖）─────────────────────────
  /// 简称（唯一短码），例如 'FT'。报告/权限链路主标识。
  code       String   @unique
  /// Logo URL。
  logo       String?
  /// 品牌色 hex。
  color      String?
  /// design.md 文档内容（Markdown 原文）。
  designMd   String?  @db.Text
  /// design.md 上传附件 URL（如有）。
  designMdUrl String?
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  advertisers Advertiser[]
  campaigns   Campaign[]
  guides      Guide[]
  marketingEvents MarketingEvent[]

  @@index([merchantId])
}

/// 广告主（子品牌/投放主体）。
model Advertiser {
  id             String         @id @default(cuid())
  name           String         @unique
  logo           String?
  businessLineId String
  businessLine   BusinessLine   @relation(fields: [businessLineId], references: [id])
  merchantId     String?
  merchant       Merchant?      @relation(fields: [merchantId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([businessLineId])
  @@index([merchantId])
  campaigns   Campaign[]
}

// ─── Phase 2: Campaign / Creator / CampaignCreator ──────────────────────────
// 核心业务实体独立成表,支持结构化查询 + 外键关联。
// DataRecord 保留作为扩展/兼容层,旧数据迁移后可废弃。

/// 营销活动（对齐营销系统 sales_activity）。
model MarketingEvent {
  id          String   @id @default(cuid())
  /// 活动名称（源 name varchar(255) NOT NULL DEFAULT ''）。
  name        String   @default("") @db.VarChar(255)
  /// 开始时间（源 start_time datetime NOT NULL DEFAULT '0000-00-00 00:00:00'）。
  startTime   DateTime @default("1970-01-01T00:00:00Z") @map("start_time")
  /// 结束时间（源 end_time datetime NOT NULL DEFAULT '0000-00-00 00:00:00'）。
  endTime     DateTime @default("1970-01-01T00:00:00Z") @map("end_time")
  /// 标识 1废弃（源 label varchar(255) NOT NULL DEFAULT ''）。
  label       String   @default("") @db.VarChar(255)
  /// 类型 1节日 2活动日 3特别促销（源 type tinyint(1) NOT NULL DEFAULT 0）。
  type        Int      @default(0) @db.TinyInt
  /// 简介（源 info text NULL）。
  info        String?  @db.Text
  /// 适用州（源 continent varchar(255) NOT NULL DEFAULT ''）。
  continent   String   @default("") @db.VarChar(255)
  /// 适用地区（源 region varchar(255) NOT NULL DEFAULT ''）。
  region      String   @default("") @db.VarChar(255)
  /// 平台评级 3高 2中 1低（源 level tinyint(1) NOT NULL DEFAULT 0）。
  level       Int      @default(0) @db.TinyInt
  /// 申请人（源 ads_id int(11) NOT NULL DEFAULT 0，关联 dm_admin.id；本地存原始 id 字符串，不建 FK——源/本地用户体系不同）。
  adsId       String   @default("0") @map("ads_id")
  /// 业务线 id（源 business_line_id int(11) NOT NULL DEFAULT 0；本地指向 BusinessLine.id，cuid 字符串）。
  businessLineId String? @map("business_line_id")
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id])
  /// 展示给流量主 1是 2否（源 is_show_member tinyint(1) NOT NULL DEFAULT 0）。
  isShowMember Int     @default(0) @db.TinyInt @map("is_show_member")
  /// 入库来源 1管理员录入 2邮件解析 3AI 解析（源 source tinyint(1) NOT NULL DEFAULT 0）。
  source      Int      @default(0) @db.TinyInt
  /// 添加人 id（源 create_id int(11) NOT NULL DEFAULT 0，关联 dm_admin.id；存原始 id 字符串）。
  createId    String   @default("0") @map("create_id")
  /// 修改人 id（源 update_id int(11) NOT NULL DEFAULT 0，关联 dm_admin.id；存原始 id 字符串）。
  updateId    String   @default("0") @db.VarChar(255) @map("update_id")
  /// 创建时间（源 create_time datetime NOT NULL DEFAULT '0000-00-00 00:00:00'）。
  createTime  DateTime @default("1970-01-01T00:00:00Z") @map("create_time")
  /// 修改时间（源 update_time datetime NOT NULL DEFAULT '0000-00-00 00:00:00' ON UPDATE CURRENT_TIMESTAMP）。
  updateTime  DateTime @default("1970-01-01T00:00:00Z") @map("update_time") @updatedAt

  @@index([businessLineId])
  @@index([startTime])
}

/// 业务线报告指南(AI 提示词层配置:品牌视觉/章节结构/展示形式/语调术语)。
model Guide {
  id             String       @id @default(cuid())
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  /// 报告场景(月报/结案/复盘…),空=通用(仅可作 isDefault 兜底,不参与精确匹配)。
  scenario       String?
  /// 展示名,如 "DG 月报指南"。
  name           String
  /// Markdown 指南正文(约定分节:品牌视觉/章节结构/展示形式偏好/语调与术语)。
  content        String       @db.Text
  /// 业务线默认指南(同业务线唯一,service 写入时互斥)。
  isDefault      Boolean      @default(false)
  /// 停用后不参与匹配(软停用,不物理删除)。
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessLineId])
}

/// 投放活动。
model Campaign {
  id        String   @id @default(cuid())
  name      String
  /// 主平台 (TikTok / Instagram / YouTube ...)。
  platform  String
  /// 开始日期 YYYY-MM-DD。
  startDate String
  /// 结束日期 YYYY-MM-DD。
  endDate   String
  /// 预算(含货币符号,如 "$300K")。
  budget    String
  /// 预算金额(结构化数值,DM deck 预算达成率用;与 budget 字符串并存,新建/编辑时写入)。
  budgetAmount   Decimal? @db.Decimal(14, 2)
  /// 预算币种(ISO 4217,如 USD;与 budgetAmount 配套)。
  budgetCurrency String?
  /// 状态:Active / Completed / Planning。
  status    String?
  /// 负责人(owner)。
  owner     String?

  /// 关联业务线(结构化 FK;兼容旧数据可空)。
  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id])
  /// 关联广告主(结构化 FK;兼容旧数据可空)。
  advertiserId String?
  advertiser   Advertiser?   @relation(fields: [advertiserId], references: [id])

  /// 旧数据兼容:businessLine / advertiser 的字符串值(如 'FT' / 'GlowLab')。
  /// 迁移后优先用 FK;保留此字段用于旧项目 meta 回读。
  businessLineCode String?
  advertiserName   String?

  /// 结构化指标 + 分析包 (值少/结构多变,保留 JSON)。
  metrics   Json?
  analytics Json?

  ownerId   String
  creator   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignCreators CampaignCreator[]
  orders           CampaignOrder[]
  orderDailyStats  OrderDailyStat[]
  linkPerformances LinkPerformance[]
  publisherDailyStats PublisherDailyStat[]
  commissionPlans  CommissionPlan[]

  @@index([ownerId])
  @@index([businessLineId])
  @@index([advertiserId])
}

/// 合作方库（达人 / 社群 / 内容站 全局主表）。
model Creator {
  id         String   @id
  name       String
  handle     String
  platform   String
  /// 合作方类型：creator(达人) / community(社群) / content_site(内容站)。默认 creator。
  partnerType String? @default("creator")
  /// 层级:mega / macro / micro。
  tier       String
  followers  String
  engagement String
  category   String
  region     String
  avatar     String?

  /// 达人主页链接（平台个人页 URL）。
  profileUrl String?
  /// MCN / 经纪公司 / 邮箱 / 电话 / 联系人。
  contact    Json?

  /// 合作报价：{ currency, post, video, live, note }。
  rate       Json?

  /// 频道 KPI 指标 + 受众画像 + 作品集 (结构多变,保留 JSON)。
  metrics    Json?
  audience   Json?
  works      Json?
  stats      Json?
  profile    Json?

  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaignCreators CampaignCreator[]
  publishers       Publisher[]

  @@index([ownerId])
  @@index([platform])
  @@index([tier])
}

/// Campaign ↔ Creator 多对多中间表 + 合作概要。
model CampaignCreator {
  id          String   @id @default(cuid())
  campaignId  String
  creatorId   String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// 合作分组 ID：一次合作（含多个 contentType）共享一个 ID。
  /// 用于将同一次合作下的多个作品（video + reels + post）关联在一起。
  collabId    String?

  /// 合作概要(可选,从旧 mock 数据补全)。
  collabType  String?
  status      String?
  contentType String?

  /// 合作总价 + 币种（一次合作可能包含多个 contentType，价格汇总在此）。
  currency    String?  @default("USD")
  totalPrice  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  performance   CreatorPerformance?
  collaboration Collaboration?
  cpsPerformances CpsPerformance[]
  orders        CampaignOrder[]
  /// 该合作的跟踪链接（1:1；数据闭环：链接来自媒体合作）。
  linkPerformance LinkPerformance?

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([collabId])
}

// ─── Phase 3: CreatorPerformance / Collaboration ────────────────────────────
// 达人执行效果 + 合作详情独立成表。
// 均挂在 CampaignCreator 下 (1:1)，通过 campaignCreatorId 关联。
// deliverables / daily / placements / cps 等子数据结构多变，保留 JSON。

/// 达人执行效果（1:1 挂在 CampaignCreator 下）。
model CreatorPerformance {
  id                String          @id @default(cuid())
  campaignCreatorId String          @unique
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  /// 汇总概要（posts / totalImpressions / totalEngagement / avgEngagementRate）。
  summary           Json
  /// 帖子效果明细（PostEffect[]）。
  posts             Json?
  /// 每天效果时间序列（CreatorDaily[]）。
  daily             Json?
  /// 投放位带货明细（PlacementPerformance[]）。
  placements        Json?
  /// CPS 带货汇总（CreatorCps）。
  cps               Json?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// 合作详情（1:1 挂在 CampaignCreator 下）。
model Collaboration {
  id                String          @id @default(cuid())
  campaignCreatorId String          @unique
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  /// 作品类型列表（CollaborationDeliverable[]，含 screenshots/metrics/audience/wordcloud）。
  deliverables      Json

  /// 旧 DataRecord 兼容 id（collab:campaignId:creatorId），用于迁移期间双通道。
  legacyId          String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([legacyId])
}

// ─── Phase 4: CPS 链接效果独立表 ────────────────────────────────────────────
// 每条 CPS 跟踪链接 = 一行；按 (campaign × creator × contentType) 归组。
// 汇总指标为结构化列，每日明细保留 JSON。

/// 报告方案：可扩展的报告类型目录（如 DM 双周报、DM 月报等）。
model ReportScheme {
  id          String   @id @default(cuid())
  /// 方案编码（如 dm-biweekly, dm-monthly）
  code        String   @unique
  /// 方案名称
  name        String
  /// 方案描述
  description String?
  /// 所属业务线 code（如 DM）
  businessLineCode String?
  /// 页数
  pageCount   Int      @default(8)
  /// 是否启用
  enabled     Boolean  @default(true)
  /// 排序权重
  sortOrder   Int      @default(0)
  /// 默认风格预设 ID
  defaultStyle String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([businessLineCode])
}

// ─── Phase 6: 订单商品明细 ──────────────────────────────────────────────────
// 订单真源在联盟平台（ShareASale/Awin 等）；此处为导入快照，用于
// Top-Sales 商品排行（含 QTY 件数）与购物篮结构分析。
// 唯一键 (campaignId, orderId) 幂等：重导覆盖（先删 items 再重建）。

/// 订单头：一行 = 一个归因订单。
model CampaignOrder {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 归因达人（campaign × creator 的 CampaignCreator.id；无归属可空）。
  campaignCreatorId String?
  campaignCreator   CampaignCreator? @relation(fields: [campaignCreatorId], references: [id])
  /// 平台订单号（幂等键组成）。
  orderId           String
  /// 下单时间。
  orderDate         DateTime?
  /// 订单状态（paid/shipped/refunded…，来自平台导出）。
  orderStatus       String?

  // ─── Awin transactions 导出字段镜像（订单级；orderId/orderDate/orderStatus
  //     已分别映射 order_reference/date/commission_status，此处为其余列） ──────
  /// Awin transaction id（CSV "id"）。
  awinId             String?
  /// Awin 广告主 id（CSV "advertiser_id"，如 105925；字符串镜像，非 FK）。
  advertiserId       String?
  /// 订单金额（CSV "sale_amount"；Lead 模式为 £1 占位）。
  saleAmount         Decimal? @db.Decimal(14, 2)
  /// 佣金（CSV "commission"）。
  commission         Decimal? @db.Decimal(14, 2)
  /// 审核通过时间（CSV "validation_date"）。
  validationDate     DateTime?
  /// 点击来源引用（CSV "click_ref"，原始未归一化）。
  clickRef           String?
  /// 交易类型（CSV "type"，Lead/Sale）。
  type               String?
  /// 站点名（CSV "site_name"）。
  siteName           String?
  /// 落地页（CSV "URL"）。
  url                String?  @db.Text
  /// 拒单原因（CSV "decline_reason"）。
  declineReason      String?
  /// 点击时间（CSV "clickThroughTime"）。
  clickThroughTime   DateTime?
  /// 是否用券（CSV "voucher_code_used"，yes/no）。
  voucherCodeUsed    String?
  /// 点击->转化时滞秒数（CSV "lapse_time"）。
  lapseTime          Int?
  /// 是否修改过（CSV "amended"，Yes/No）。
  amended            String?
  /// 修改原因（CSV "amend_reason"）。
  amendReason        String?
  /// 修改前金额（CSV "old_sale_amount"）。
  oldSaleAmount      Decimal? @db.Decimal(14, 2)
  /// 修改前佣金（CSV "old_commission"）。
  oldCommission      Decimal? @db.Decimal(14, 2)
  /// 币种差异（CSV "different_currency"）。
  differentCurrency  String?
  /// 点击设备（CSV "click_device"）。
  clickDevice        String?
  /// 交易设备（CSV "transaction_device"）。
  transactionDevice  String?
  /// 发布商跟踪 URL（CSV "publisher_url"，cloak 长链）。
  publisherUrl       String?  @db.Text
  /// 佣金构成（CSV "transaction_parts"，如 DEFAULT:1.50）。
  transactionParts   String?
  /// 客户国家（CSV "customer_country"）。
  customerCountry    String?
  /// 自定义参数（CSV "custom_parameters"）。
  customParameters   String?  @db.Text
  /// 是否已付发布商（CSV "paid_to_publisher"，yes/no）。
  paidToPublisher    String?
  /// 支付状态（CSV "payment_status"）。
  paymentStatus      String?
  /// 支付 ID（CSV "payment_id"）。
  paymentId          String?
  /// 查询 ID（CSV "transaction_query_id"）。
  transactionQueryId String?
  /// 附加点击引用 2-6（CSV "click_ref2".."click_ref6"）。
  clickRef2          String?
  clickRef3          String?
  clickRef4          String?
  clickRef5          String?
  clickRef6          String?
  /// 券码（CSV "voucher_code"）。
  voucherCode        String?
  /// 佣金分成的发布商 id/名/所选分成率发布商 id（CSV 对应三列）。
  commissionSharingPublisherId             String?
  commissionSharingPublisher               String?
  commissionSharingSelectedRatePublisherId String?
  /// 商品明细原始数据（CSV "products"）。
  products           String?  @db.Text
  /// Awin campaign 标签（CSV "campaign"；注意与 campaignId FK 无关）。
  campaignLabel      String?
  /// 新客标记（CSV "customer_acquisition"）。
  customerAcquisition String?

  items             CampaignOrderItem[]

  /// 归因媒体（publisher 维度；导入时按 publisherUrl 域名归一化解析）。
  publisherId       String?
  publisher         Publisher? @relation(fields: [publisherId], references: [id])
  /// 归因链接（publisher_url 对应的 LinkPerformance 行；导入时自动挂）。
  linkPerformanceId String?
  linkPerformance   LinkPerformance? @relation(fields: [linkPerformanceId], references: [id])

  @@unique([campaignId, orderId])
  @@index([campaignId])
  @@index([campaignId, orderDate])
  @@index([campaignCreatorId])
  @@index([publisherId])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// 订单商品行：一行 = 订单 × 商品。
model CampaignOrderItem {
  id          String         @id @default(cuid())
  order       CampaignOrder  @relation(fields: [campaignOrderId], references: [id], onDelete: Cascade)
  campaignOrderId String
  /// 商品主档 FK（导入时自动 upsert Product 匹配；旧行未匹配可空）。
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id])
  /// 商品名（平台导出原名）。
  productName String
  /// 品类标签（可选，来自商品库或人工标注）。
  category    String?
  /// SKU（可选）。
  sku         String?
  /// 购买件数 ← QTY 排行榜数据源。
  qty         Int            @default(1)
  /// 单价。
  unitPrice   Decimal        @default(0) @db.Decimal(14, 2)
  /// 行小计 = qty × unitPrice。
  lineTotal   Decimal        @default(0) @db.Decimal(14, 2)

  @@index([campaignOrderId])
  @@index([productName])
}

/// 订单日级统计中间层（recomputeOrderStats 从 CampaignOrder 物化）。
/// 报告数字真源：Revenue/Commission/Orders 以本表为准（订单表 SUM 的快照，
/// 与 CpsPerformance.daily 导入副本解耦）。日期口径 = 订单表已存 UTC 值
/// DATE_FORMAT 截断，不做二次时区转换。
model OrderDailyStat {
  id        String   @id @default(cuid())
  campaignId String
  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// ''（哨兵）= 该日全 campaign 聚合行；非空 = CampaignCreator.id 的 creator×date 行。
  /// MySQL 唯一索引对 NULL 不去重，故用空串而非 NULL 表示聚合行。
  campaignCreatorId String @default("")

  /// 统计日（YYYY-MM-DD）。
  statDate  String

  totalOrders        Int      @default(0)
  approvedOrders     Int      @default(0)
  pendingOrders      Int      @default(0)
  /// declined/deleted 等非 Approved/Pending 状态。
  otherOrders        Int      @default(0)
  /// Revenue 真源（Lead 模式佣金口径；saleAmount £1 占位不作为收入）。
  totalCommission    Decimal  @default(0) @db.Decimal(14, 2)
  approvedCommission Decimal  @default(0) @db.Decimal(14, 2)
  pendingCommission  Decimal  @default(0) @db.Decimal(14, 2)
  /// SUM(saleAmount)，Lead 模式为占位值，存档不用作 Revenue。
  totalSaleAmount    Decimal  @default(0) @db.Decimal(14, 2)
  /// customerAcquisition='New' 等标签的单量；标签缺失时恒 0。
  newCustomerOrders  Int      @default(0)
  /// 该行统计范围内任一单带 customerAcquisition 标签；false = 概念不适用，渲染 N/A。
  hasNewCustomerTag  Boolean  @default(false)
  /// 国家维度 Top5：[{country, orders, commission}]（开放集合，仅展示用）。
  topCountries       Json?
  /// 设备维度 Top5：[{device, orders}]（clickDevice 100% 有值；仅聚合行挂）。
  topDevices         Json?

  recomputedAt DateTime @default(now())

  @@unique([campaignId, statDate, campaignCreatorId])
  @@index([campaignId, statDate])
  @@index([campaignCreatorId])
}

/// CPS 链接效果（一行=一条 CPS 跟踪链接的汇总数据）。
model CpsPerformance {
  id                String          @id @default(cuid())
  campaignCreatorId String
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  /// 归属的合作作品类型（post / reels / video / image / live / story）。
  contentType       String
  /// CPS 跟踪链接 URL。
  linkUrl           String?

  /// 结构化汇总指标（直接可查、可聚合）。
  clicks            Int             @default(0)
  impressions       Int             @default(0)
  orders            Int             @default(0)
  gmv               Decimal         @default(0) @db.Decimal(14, 2)
  commission        Decimal         @default(0) @db.Decimal(14, 2)
  spend             Decimal         @default(0) @db.Decimal(14, 2)

  /// 维度标签(链接级,一条 CPS 链接一组维度;recipe Insight & Analysis 聚合用)。
  productName String?
  category    String?
  market      String?
  promoName   String?
  promoType   String?

  /// 每日明细（CpsDaily[] JSON）。
  daily             Json?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([campaignCreatorId, contentType])
  @@index([campaignCreatorId])
}

// ─── 媒体维度 / 链接效果 / 商品主档（2026-08-25 数据结构升级） ────────────────
// 概念澄清：订单先归因到「链接（publisher_url）」，链接属于「媒体（publisher）」，
// 达人只是媒体的一种类型。clicks/impressions/ctr/cvr/epc 全部是链接维度指标。

/// 佣金方案时间线:campaign × 时段 × 方案(CPA% / flat fee)。
/// DM deck「佣金变更→销量变化」叙事的数据基础;报表按月取当期有效方案。
model CommissionPlan {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 方案名(如 "Q1 冲量方案")。
  name        String?
  /// 生效日(含,YYYY-MM-DD)。
  startDate   String
  /// 失效日(含;null=至今有效/开放式)。
  endDate     String?
  /// CPA 佣金率(小数,0.10=10%)。
  cpaRate     Decimal? @db.Decimal(6, 4)
  /// 固定费用(月或一次性,配 frequency)。
  flatFee     Decimal? @db.Decimal(14, 2)
  /// 固定费用周期:monthly / one_time;null=无固定费。
  flatFeeFrequency String?
  /// 备注(调价原因等,DM 叙事素材)。
  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId])
  @@index([campaignId, startDate])
}

/// 媒体主档：推广渠道的载体（达人 / 社群 / 内容站 / 媒体站…）。
/// 与 Creator 的关系：partnerType=creator 的媒体可挂 creatorId；其余类型独立存在。
model Publisher {
  id        String   @id @default(cuid())
  /// 媒体名称（site_name 或人工维护）。
  name      String
  /// 媒体类型：creator(达人) / community(社群) / content_site(内容站) / media_site(媒体站)。
  type      String   @default("media_site")
  /// 归一化域名（小写、去 www；publisher_url 解析键）。唯一。
  domain    String   @unique
  /// 平台（TikTok/Instagram/…，达人型媒体适用）。
  platform  String?
  /// 媒体主页 URL。
  url       String?
  /// 达人型媒体关联的达人主档（非达人型为空）。
  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id])
  /// 备注。
  note      String?

  links    LinkPerformance[]
  orders   CampaignOrder[]
  dailyStats PublisherDailyStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 链接效果表：一条推广链接的全周期汇总（Click_References.csv 口径）。
/// clicks/impressions 是链接维度指标（联盟平台导出）；orders/gmv/commission
/// 同时保留（导入快照）--页面实时聚合以订单表为准，两者互为校验。
///
/// ★ 数据闭环（0826 用户定稿）：订单来自链接，链接来自媒体合作
///   Campaign 1:N CampaignCreator（媒体合作）1:1 LinkPerformance（链接）1:N CampaignOrder（订单）。
///   campaignCreatorId 直接挂合作行（勿再经 publisher.creatorId 间接推导）；
///   唯一约束 = 业务规则「1 次合作只有 1 个链接」（MySQL 唯一索引允许多 NULL，未归因存量可共存）。
model LinkPerformance {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 归属媒体。
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  /// 归属媒体合作行（CampaignCreator；闭环 FK）。可空=尚未归因（回填/导入自动挂）。
  campaignCreatorId   String?
  campaignCreator     CampaignCreator? @relation(fields: [campaignCreatorId], references: [id])
  /// 原始链接 URL（cloak 长链）。
  linkUrl     String?  @db.Text
  /// 归一化链接键（click_ref 原值或域名；同一链接多渠道拆分时的唯一业务键组成）。
  linkKey     String

  /// 链接维度指标（联盟平台导出真源）。
  clicks      Int      @default(0)
  impressions Int      @default(0)
  orders      Int      @default(0)
  gmv         Decimal  @default(0) @db.Decimal(14, 2)
  commission  Decimal  @default(0) @db.Decimal(14, 2)
  spend       Decimal  @default(0) @db.Decimal(14, 2)

  /// 每日明细 [{date, clicks, impressions, orders, gmv, commission}]。
  daily       Json?

  /// 溯源：本行由哪条 CpsPerformance 迁移而来（存量迁移用，可空）。
  migratedFromCpsId String?

  attributedOrders CampaignOrder[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, publisherId, linkKey])
  /// 1 次合作只有 1 个链接（0826 定稿；NULL 不参与唯一性，未归因行可共存）。
  @@unique([campaignCreatorId], map: "uq_link_performance_campaign_creator")
  @@index([campaignId])
  @@index([publisherId])
}

/// 媒体日统计中间表（campaign × publisher × 日）：达人数据统计 / campaign 数据统计的直查源。
/// 成交侧从 CampaignOrder 按 publisherId 聚合；流量侧从 LinkPerformance.daily 合并。
model PublisherDailyStat {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  /// 统计日（YYYY-MM-DD）。
  statDate    String

  /// 流量侧（链接维度，来自 LinkPerformance.daily 合并；无导入则 0）。
  clicks      Int       @default(0)
  impressions Int       @default(0)
  /// 成交侧（订单表逐单聚合真源）。
  orders      Int       @default(0)
  gmv         Decimal   @default(0) @db.Decimal(14, 2)
  commission  Decimal   @default(0) @db.Decimal(14, 2)

  recomputedAt DateTime @default(now())

  @@unique([campaignId, publisherId, statDate])
  @@index([campaignId, statDate])
  @@index([publisherId])
}

/// 商品主档：订单商品行的结构化归集（Top-Sales 排行 / 购物篮分析的基础）。
model Product {
  id         String   @id @default(cuid())
  /// 商品名（导入原名；幂等键之一）。
  name       String
  /// SKU（幂等键之一；两者都有时 (name, sku) 联合匹配）。
  sku        String?
  /// 品类。
  category   String?
  /// 商品图（可选）。
  imageUrl   String?  @db.Text

  items      CampaignOrderItem[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
  @@index([sku])
}

// ─── Phase 5: HTML Report Templates & AI Generation ──────────────────────────
// 独立 HTML 模板体系，用于一键生成 HTML 报告（与 PPT 模板分开管理）。

/// HTML 报告模板：含占位符的 HTML 文件，由 ADMIN 维护。
model HtmlTemplate {
  id          String   @id @default(cuid())
  name        String
  /// 模板 HTML 内容（含 {{placeholder}} 变量占位符）。
  html        String   @db.LongText
  /// 模板描述（可选）。
  description String?
  /// 模板分类标签（如 '投放结案' '达人复盘'）。
  category    String?
  /// 缩略图 URL（可选）。
  thumbnail   String?
  /// 发布状态（草稿/已发布），与 PPT 模板一致。
  status      TemplateStatus @default(DRAFT)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([category])
}
