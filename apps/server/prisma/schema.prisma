// MediaKit Prisma schema (MySQL 8)
// 对齐 design spec §3.3 — pages 为不透明 JSON，组件类型扩展不触发迁移。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         Role       @default(USER)
  projects     Project[]
  templates    Template[]
  dataRecords  DataRecord[]
  campaigns    Campaign[]
  creators     Creator[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

model Project {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  pages      Json
  width      Int      @default(1280)
  height     Int      @default(720)
  shareToken String?  @unique
  // 项目元数据（业务线/创建人/场景/广告主/campaign 信息），不透明 JSON。
  meta       Json?
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

/// 报告模版：由设计师(ADMIN)维护、按场景+业务线分类，供 BD 基于模版创建报告。
/// pages/width/height/meta 结构与 Project 完全一致，编辑器可直接复用。
model Template {
  id         String           @id @default(cuid())
  name       String
  pages      Json
  width      Int              @default(1280)
  height     Int              @default(720)
  meta       Json?
  status     TemplateStatus   @default(DRAFT)
  /// 设计师备注（可选），仅管理后台可见。
  note       String?
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

/// 数据管理库记录:Campaign / 达人库(Creator)统一存储,opaque JSON payload。全员可管,ownerId 标记创建者。
model DataRecord {
  /// id 由应用层生成(opaque),不使用 cuid() 默认值——便于导入按 id upsert 幂等。
  id        String          @id
  kind      DataRecordKind
  ownerId   String
  data      Json
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([kind])
  @@index([ownerId])
}

/// 数据记录类型。
enum DataRecordKind {
  CAMPAIGN
  CREATOR
  COLLABORATION
}

// ─── Phase 1: 结构化查找表 ─────────────────────────────────────────────────
// 将 mock 常量提升为独立表,支持 CRUD 管理 + 结构化查询。

/// 商家（母品牌/旗舰店）。
model Merchant {
  id        String         @id @default(cuid())
  name      String         @unique
  logo      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  businessLines BusinessLine[]
  advertisers  Advertiser[]
}

/// 业务线（FT / SM / CX / DG / KN / DM）。
model BusinessLine {
  id         String         @id @default(cuid())
  code       String         @unique
  name       String
  logo       String?
  color      String?
  merchantId String
  merchant   Merchant       @relation(fields: [merchantId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  advertisers Advertiser[]
  campaigns   Campaign[]

  @@index([merchantId])
}

/// 广告主（子品牌/投放主体）。
model Advertiser {
  id             String         @id @default(cuid())
  name           String         @unique
  logo           String?
  businessLineId String
  businessLine   BusinessLine   @relation(fields: [businessLineId], references: [id])
  merchantId     String?
  merchant       Merchant?      @relation(fields: [merchantId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([businessLineId])
  @@index([merchantId])
  campaigns   Campaign[]
}

// ─── Phase 2: Campaign / Creator / CampaignCreator ──────────────────────────
// 核心业务实体独立成表,支持结构化查询 + 外键关联。
// DataRecord 保留作为扩展/兼容层,旧数据迁移后可废弃。

/// 投放活动。
model Campaign {
  id        String   @id @default(cuid())
  name      String
  /// 主平台 (TikTok / Instagram / YouTube ...)。
  platform  String
  /// 开始日期 YYYY-MM-DD。
  startDate String
  /// 结束日期 YYYY-MM-DD。
  endDate   String
  /// 预算(含货币符号,如 "$300K")。
  budget    String
  /// 状态:Active / Completed / Planning。
  status    String?
  /// 负责人(owner)。
  owner     String?

  /// 关联业务线(结构化 FK;兼容旧数据可空)。
  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id])
  /// 关联广告主(结构化 FK;兼容旧数据可空)。
  advertiserId String?
  advertiser   Advertiser?   @relation(fields: [advertiserId], references: [id])

  /// 旧数据兼容:businessLine / advertiser 的字符串值(如 'FT' / 'GlowLab')。
  /// 迁移后优先用 FK;保留此字段用于旧项目 meta 回读。
  businessLineCode String?
  advertiserName   String?

  /// 结构化指标 + 分析包 (值少/结构多变,保留 JSON)。
  metrics   Json?
  analytics Json?

  ownerId   String
  creator   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignCreators CampaignCreator[]

  @@index([ownerId])
  @@index([businessLineId])
  @@index([advertiserId])
}

/// 达人库（全局达人主表）。
model Creator {
  id         String   @id
  name       String
  handle     String
  platform   String
  /// 层级:mega / macro / micro。
  tier       String
  followers  String
  engagement String
  category   String
  region     String
  avatar     String?

  /// 频道 KPI 指标 + 受众画像 + 作品集 (结构多变,保留 JSON)。
  metrics    Json?
  audience   Json?
  works      Json?

  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaignCreators CampaignCreator[]

  @@index([ownerId])
  @@index([platform])
  @@index([tier])
}

/// Campaign ↔ Creator 多对多中间表 + 合作概要。
model CampaignCreator {
  id          String   @id @default(cuid())
  campaignId  String
  creatorId   String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// 合作概要(可选,从旧 mock 数据补全)。
  collabType  String?
  status      String?
  contentType String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  performance   CreatorPerformance?
  collaboration Collaboration?

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
}

// ─── Phase 3: CreatorPerformance / Collaboration ────────────────────────────
// 达人执行效果 + 合作详情独立成表。
// 均挂在 CampaignCreator 下 (1:1)，通过 campaignCreatorId 关联。
// deliverables / daily / placements / cps 等子数据结构多变，保留 JSON。

/// 达人执行效果（1:1 挂在 CampaignCreator 下）。
model CreatorPerformance {
  id                String          @id @default(cuid())
  campaignCreatorId String          @unique
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  /// 汇总概要（posts / totalImpressions / totalEngagement / avgEngagementRate）。
  summary           Json
  /// 帖子效果明细（PostEffect[]）。
  posts             Json?
  /// 每天效果时间序列（CreatorDaily[]）。
  daily             Json?
  /// 投放位带货明细（PlacementPerformance[]）。
  placements        Json?
  /// CPS 带货汇总（CreatorCps）。
  cps               Json?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// 合作详情（1:1 挂在 CampaignCreator 下）。
model Collaboration {
  id                String          @id @default(cuid())
  campaignCreatorId String          @unique
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  /// 作品类型列表（CollaborationDeliverable[]，含 screenshots/metrics/audience/wordcloud）。
  deliverables      Json

  /// 旧 DataRecord 兼容 id（collab:campaignId:creatorId），用于迁移期间双通道。
  legacyId          String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([legacyId])
}
