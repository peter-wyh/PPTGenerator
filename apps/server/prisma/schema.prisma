// MediaKit Prisma schema (MySQL 8)
// 对齐 design spec §3.3 — pages 为不透明 JSON，组件类型扩展不触发迁移。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         Role       @default(USER)
  projects     Project[]
  templates    Template[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

model Project {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  pages      Json
  width      Int      @default(1280)
  height     Int      @default(720)
  shareToken String?  @unique
  // 项目元数据（业务线/创建人/场景/广告主/campaign 信息），不透明 JSON。
  meta       Json?
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

/// 报告模版：由设计师(ADMIN)维护、按场景+业务线分类，供 BD 基于模版创建报告。
/// pages/width/height/meta 结构与 Project 完全一致，编辑器可直接复用。
model Template {
  id         String           @id @default(cuid())
  name       String
  pages      Json
  width      Int              @default(1280)
  height     Int              @default(720)
  meta       Json?
  status     TemplateStatus   @default(DRAFT)
  /// 设计师备注（可选），仅管理后台可见。
  note       String?
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}
